[sub_resource type="GDScript" id="GDScript_nfrx5"]
resource_name = "audio"
script/source = "extends Button

var muted:=false

func _ready():
	var bus_idx = AudioServer.get_bus_index(\"Master\")
	text = \"OFF\" if AudioServer.is_bus_mute(bus_idx) else \"ON\"

func _on_pressed() -> void:
	var bus_idx = AudioServer.get_bus_index(\"Master\")
	AudioServer.set_bus_mute(bus_idx, not muted)
	muted = not muted
	text = \"ON\" if not muted else \"OFF\"
"

[sub_resource type="GDScript" id="GDScript_qp6js"]
resource_name = "batatis"
script/source = "extends Button

func _ready():
	text = \"ON\" if DisplayServer.window_get_mode() \\
	== DisplayServer.WINDOW_MODE_FULLSCREEN \\
	else \"OFF\"

func _on_pressed() -> void:
	var mode := DisplayServer.window_get_mode()
	
	if mode == DisplayServer.WINDOW_MODE_WINDOWED:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
		text = \"ON\"
	else:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)
		text = \"OFF\"
"

